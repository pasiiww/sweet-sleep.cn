[Unit]
Description=Sweet Sleep Knowledge API
After=network.target

[Service]
Type=simple
User=sweet-knowledge
Group=sweet-knowledge
WorkingDirectory=/opt/sweet-knowledge
EnvironmentFile=/etc/sweet-knowledge.env
ExecStart=/usr/bin/python3 /opt/sweet-knowledge/server.py
Restart=on-failure
RestartSec=3
StateDirectory=sweet-knowledge
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sweet-knowledge
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=350M
TasksMax=64

[Install]
WantedBy=multi-user.target
